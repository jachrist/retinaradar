{
  "name": "retinaradar",
  "version": "0.1.0",
  "private": true,
  "description": "Ukentlig overvåking av forskning og kliniske studier om arvelig netthinnesykdom",
  "type": "module",
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/functions": "^4.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
